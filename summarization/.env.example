# Copy to summarization/.env  (or the project root .env) and edit.
# Restart uvicorn after every change - auto-reload does NOT re-read .env.

# --- LLM server: any OpenAI-compatible endpoint (Kaggle+ngrok, vLLM on RunPod, Ollama /v1, ...) ---
SUMMARY_LLM_BACKEND=openai_compat        # use "mock" to test without a GPU
# Kaggle: copy both values printed at the end of the notebook cell (the URL changes every run)
SUMMARY_LLM_BASE_URL=https://YOUR-NGROK-URL.ngrok-free.app/v1
SUMMARY_LLM_API_KEY=YOUR_API_KEY
SUMMARY_LLM_MODEL=Qwen/Qwen3.5-9B

# The Kaggle server ignores JSON mode, so keep this off (the module repairs bad JSON itself)
SUMMARY_JSON_MODE=off
# Sent to the server as chat_template_kwargs.enable_thinking=false (Qwen3 / Qwen3.5)
SUMMARY_DISABLE_THINKING=true

# --- sizing: SUMMARY_CONTEXT_TOKENS must equal the server's usable context ---
SUMMARY_CONTEXT_TOKENS=8192
SUMMARY_CHUNK_TOKENS=3000
SUMMARY_MAX_OUTPUT_TOKENS=2048
SUMMARY_FINAL_MAX_OUTPUT_TOKENS=3072     # Kaggle cell caps output at 3072; don't go higher

# --- robustness: a 4-bit 9B model on a T4 is slow, so be generous ---
SUMMARY_REQUEST_TIMEOUT=900
SUMMARY_TOTAL_TIMEOUT=3600
SUMMARY_MAX_RETRIES=1
SUMMARY_MAX_CONCURRENCY=1                # the Kaggle server handles one generation at a time
SUMMARY_TEMPERATURE=0.1
# After the summary: verify every date found in the transcript is in it; re-ask once if not
SUMMARY_COVERAGE_CHECK=true
SUMMARY_DEFAULT_LANGUAGE=English
